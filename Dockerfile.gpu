# GPU版本 Dockerfile - 使用GOT-OCR 2.0 (580M参数，仅需4GB显存)
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    libreoffice \
    libreoffice-writer \
    libreoffice-impress \
    poppler-utils \
    git \
    wget \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 创建软链接
RUN ln -s /usr/bin/python3.10 /usr/bin/python

# 安装PyTorch (CUDA 12.1版本)
RUN pip install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu121

# 安装GOT-OCR 2.0及其依赖
RUN pip install --no-cache-dir \
    transformers==4.37.2 \
    tiktoken==0.6.0 \
    verovio==4.3.1 \
    accelerate==0.28.0 \
    Pillow \
    pdf2image \
    python-docx

# 安装PaddleOCR GPU版本 (备选引擎)
RUN pip install --no-cache-dir \
    paddlepaddle-gpu \
    paddleocr

# 创建输入输出目录
RUN mkdir -p /input /output /models

WORKDIR /app

CMD ["/bin/bash"]
